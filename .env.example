# Copy these into GitHub repo: Settings -> Secrets and variables -> Actions -> New repository secret
GEMINI_API_KEY=
# Optional extra Gemini keys (or comma-separate keys in GEMINI_API_KEY):
# the pipeline fails over to the next key when one is rate-limited (429).
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
PEXELS_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Optional variables (Settings -> Variables, or edit workflow env):
# VISIBILITY=private
# Optional failure alerts (Secrets; set either or both, or neither):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Optional duration guard bounds (seconds). Narration targets ~120s (2-min
# Short); the guard only rejects broken TTS output, so leave wide.
# MIN_AUDIO_SEC=10
# MAX_AUDIO_SEC=180
# Optional TTS prosody (dramatic horror delivery; edge-tts relative values):
# TTS_RATE=-5%
# TTS_PITCH=-10Hz
# TTS_VOLUME=+0%
# Optional background music volume (linear scale, default 0.08; 0.20 was old loud level):
# BGM_VOLUME=0.08
# TTS engine chain (default edge -> gemini fallback; "edge" = free edge-tts
# with word-level captions; "gemini" = remote engine with beat-level captions):
# TTS_ENGINE=edge
# TTS_PROVIDER_ORDER=edge,gemini
# Optional: Gemini TTS narrator voice (default Charon; a comma-separated
# pool alternates voices per run instead). 30 prebuilt voices (AI Studio voice library),
# e.g. Charon/Fenrir male, Kore/Aoede female:
# GEMINI_TTS_VOICES=Charon
# Optional: Gemini TTS delivery style (plain-language direction). Empty/unset
# defaults to adaptive narration-dependent delivery: natural articulate documentary
# storyteller voice that dynamically tunes per beat (hook intrigue -> countdown
# momentum -> #1 reveal awe -> warm outro) and content mood (danger, scale, speed, mystery).
# Setting a non-blank style acts as an explicit base style override:
# GEMINI_TTS_STYLE=Read in a natural, articulate documentary voice with steady pacing.
# OpenRouter :free text failover for Gemini outages (warn-only fallback,
# max 2 models x 1 try, never raises; code default wins so no workflow
# change needed):
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
# OpenRouter model for Pillow visual code generation (fallback when Gemini fails).
# Qwen3.8-27B is the free-tier coder model; override to any OpenRouter model slug:
# OPENROUTER_VISUAL_MODEL=qwen/qwen3.8-27b:free
# Optional model override (tried in order, first win; wins over STORY_MODELS):
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash
# Optional Gemini TTS voice-model list override (tried in order, first win):
# TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
# Optional Gemini failover pacing (fail fast during outages: short timeout,
# few tries; timeouts jump to the next key immediately, fast 5xx may retry,
# 429 backs off with jitter on the same key). GEMINI_TIMEOUT is the text
# path (script/topic); TTS voice calls run longer (healthy calls reach 20s+,
# keep 60-120):
# GEMINI_TIMEOUT=40
# GEMINI_TTS_TIMEOUT=90
# GEMINI_TRIES=2
# GEMINI_BACKOFF=5
# Hybrid topics: Gemini proposes a fresh explainer topic each run (validated,
# pool backstop on reject/fail). Kill switch if quota hurts:
# AI_TOPICS=off
# Optional: cuts per story beat (ranking niche STILLS_PER_BEAT=2,
# explainer niche EXPLAINER_STILLS_PER_BEAT=2; 1 = one visual per beat).
# STILLS_PER_BEAT=2
# EXPLAINER_STILLS_PER_BEAT=2
# Optional: TikTok dual-post via Buffer (free plan: 3 channels, 10 queued
# posts/channel, 1 API key). YouTube upload stays as-is; only TikTok goes
# through Buffer (Buffer's audited TikTok app posts publicly, no TikTok
# audit of your own needed). Buffer has no upload endpoint, so the mp4 must
# be hosted at a public URL first — Cloudinary unsigned preset (free tier,
# hardcoded defaults in core.py: cloud "epuxrxa5", preset "buffer_shorts").
# 1. buffer.com -> connect TikTok channel only -> publish.buffer.com/settings/api -> key
# 2. Cloudinary defaults already work; override only if you use your own account:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# BUFFER_API_KEY=
# BUFFER_TIKTOK_CHANNEL_ID=  # optional: auto-picks the TikTok channel when empty
# Optional contact for the advisory Wikipedia existence check User-Agent
# (MediaWiki policy asks for a reachable contact; built-in default wins,
# so no workflow change is required):
# WIKI_CONTACT=mailto:you@example.com
# --- Phase 2: story-niche pipeline (append-only; all existing vars above intact) ---
# Gemini TTS speech model (default = current first-win flash TTS preview model in core.py):
# TTS_MODEL=gemini-3.1-flash-tts-preview
# Comma-separated narrator voice pool for story narration:
# TTS_VOICES=
# Narration speed multiplier applied at render (default 1.15):
# NARRATION_SPEED=1.15
# NOTE: PEXELS_API_KEY already defined above (line 8); reused for story backgrounds.
# Directory of looping background videos (tracked placeholder only, content ignored):
# BG_DIR=assets/backgrounds/
# Story segment length bounds in seconds (clips cut to SEG_MIN..SEG_MAX):
# SEG_MIN=2.0
# SEG_MAX=4.0
# Background playback speed range, satisfying-timelapse defaults
# (cleaning footage needs 3.2-4.5x to read as motion):
# BG_SPEED_MIN=3.2
# BG_SPEED_MAX=4.5
# Uppercase captions flag (1 = uppercase, 0 = as-transcribed):
# CAPTION_UPPER=0
# Still-card fallback/minimum seconds when no background video is available:
# CARD_SECONDS=3.0
# Public channel handle shown on the story card (e.g. @UnhingedStories):
# CHANNEL_HANDLE=
# Channel logo file: square-ish PNG at assets/avatar.png, ellipse-masked
# to a circle on the card (missing file -> initial-fallback circle):
# AVATAR_PATH=assets/avatar.png
# Maximum total story video length in seconds:
# MAX_SECONDS=45
# Comma-separated story genres to rotate through (e.g. horror,scifi,mystery):
# STORY_GENRES=
# Word timings are estimated proportionally — no local transcription
# models are downloaded or run anywhere in this pipeline.
# --- Phase 3b: multi-niche wiring (append-only; nothing above removed) ---
# Generic section: NICHE selects the niches/* subpackage (default story).
# Bare names above stay as cross-niche fallbacks; a per-niche prefixed name
# always wins over its bare fallback (see niches/base.py env_* helpers).
# NICHE=story
# --- STORY_ (100-120s Reddit stories; read in niches/story/config.py) ---
# STORY_TTS_MODEL=gemini-2.5-flash-preview-tts
# STORY_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
# STORY_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash
# STORY_TTS_VOICES=Kore,Charon,Puck
# Edge narrator voice pool (STORY_EDGE_VOICES comma-separated wins;
# STORY_EDGE_VOICE singular is a one-voice fallback; unset = default
# Andrew+M (boy stories) / Aria+F (girl stories) pool, picked per video
# by the story's narrator_gender):
# STORY_EDGE_VOICES=en-US-AndrewNeural,en-US-AriaNeural
# STORY_EDGE_VOICE=en-US-AriaNeural
# STORY_NARRATION_SPEED=1.15
# Trim per-chunk leading/trailing silence before concat (gapless narration, no baked pauses):
# STORY_TRIM_CHUNK_SILENCE=1
# Controlled inter-chunk pause restored after trim (seconds, 0.0-0.5; 0.10 = slight natural beat):
# STORY_CHUNK_PAUSE_SEC=0.10
# STORY_SEG_MIN=2.5
# STORY_SEG_MAX=4.5
# STORY_BG_SPEED_MIN=3.2
# STORY_BG_SPEED_MAX=4.5
# Satisfying-cleaning pool: clips fetched per cleaning query (default 3,
# deeper than CLIPS_PER_QUERY=2) and the planner share of segments drawn
# from cleaning clips as consecutive runs (0.0-1.0):
# STORY_CLEANING_CLIPS_PER_QUERY=3
# STORY_CLEANING_SHARE=0.55
# Motion bias for Pexels search text (0.0-1.0; 0 = queries verbatim,
# >0 = static-leaning queries rewritten toward moving footage):
# STORY_MOTION_BIAS=1.0
# Narrator voice: auto alternates male/female by history parity (odd =
# male, even = female); male or female forces one voice:
# STORY_NARRATOR_GENDER_MODE=auto
# STORY_CAPTION_UPPER=0
# STORY_CARD_SECONDS=3.0
# YouTube thumbnail frame offset in seconds (default 1.0s, clamped inside
# the opening card's visible window; extracted 1080x1920 JPG <2MB):
# STORY_THUMB_OFFSET_SECONDS=1.0
# STORY_CHANNEL_HANDLE=@UnhingedStories
# STORY_AVATAR_PATH=assets/avatar.png
# Card engagement row (decorative placeholders, KoalaReads-style):
# STORY_CARD_LIKES=420+
# STORY_CARD_SHARES=420+
# STORY_CARD_SHOW_REACTIONS=1
# Uploaded background clips go here as bg1.mp4 ... bg10.mp4 (any BG_EXTS
# video: .mp4/.mov/.webm/.mkv). One is picked at random per video and
# played as a single continuous take; Pexels is only the fallback when
# this folder has no clips:
# STORY_BG_DIR=assets/backgrounds
# Which source wins when both are available: local_first (default) or pexels_first:
# STORY_BG_SOURCE=local_first
# Playback speed for the single continuous take (default 1.8x, mild):
# STORY_BG_SINGLE_SPEED=1.8
# BGM pool folder (filename pattern stays STORY_BGM_GLOB, default bgm*.mp3;
# the repo root is still used when this folder is missing):
# STORY_BGM_DIR=assets/background-musics
# BGM bed level in the final render mix (linear pre-duck gain; the bed loops
# at unity so this value is the only thing setting the music level):
# STORY_BGM_VOLUME=0.20
# STORY_MAX_SECONDS=130.0
# STORY_TARGET_MIN=100.0
# STORY_TARGET_MAX=120.0
# Edge-aware word budget: history wps scaled by STORY_EDGE_RATE, then
# STORY_LENGTH_OVERSHOOT (default 1.08, 1.05-1.10) so drafts aim mid-range.
# STORY_EDGE_RATE=+20%
# Female edge voices (Aria/Ava) run a slower natural cadence at the same
# relative rate, so STORY_EDGE_RATE_FEMALE (default +28%) bumps them to
# land near Andrew's absolute pace; male/custom voices stay on EDGE_RATE.
# STORY_EDGE_RATE_FEMALE=+28%
# STORY_LENGTH_OVERSHOOT=1.08
# Per-model draft attempts: Lite models retry out-of-range drafts up to
# this many times per model (default 5, clamped 1-8); others keep 2.
# STORY_LITE_RETRIES=5
# STORY_STORY_GENRES=AITA,revenge,workplace,relationship,scary,never-again
# STORY_WHISPER_MODEL=base
# STORY_PEXELS_API_KEY=
# --- EXPLAINER_ (how-things-work; read in niches/explainer/config.py) ---
# EXPLAINER_VOICE=en-US-ChristopherNeural
# EXPLAINER_TTS_RATE=-5%
# EXPLAINER_TTS_PITCH=-10Hz
# EXPLAINER_TTS_VOLUME=+0%
# EXPLAINER_TTS_ENGINE=gemini
# EXPLAINER_GEMINI_TTS_VOICES=Charon
# EXPLAINER_STILLS_PER_BEAT=2
# EXPLAINER_MIN_AUDIO_SEC=10
# EXPLAINER_MAX_AUDIO_SEC=180
# EXPLAINER_PEXELS_MIN_WIDTH=1080
# --- RANKING_ (Top-5 countdowns; read in niches/ranking/config.py) ---
# RANKING_VOICE=Charon
# RANKING_TTS_VOICES=Charon
# RANKING_TTS_RATE=-5%
# RANKING_TTS_PITCH=-10Hz
# RANKING_TTS_VOLUME=+0%
# RANKING_TTS_STYLE=
# RANKING_TONE=adaptive
# RANKING_TARGET_WPM=145
# RANKING_STILLS_PER_BEAT=3
# RANKING_MIN_AUDIO_SEC=10
# RANKING_MAX_AUDIO_SEC=180
# RANKING_PEXELS_MIN_WIDTH=1080
# RANKING_PEXELS_CACHE_DIR=assets
# RANKING_BGM_VOLUME=0.08
