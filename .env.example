# Copy these into GitHub repo: Settings -> Secrets and variables -> Actions -> New repository secret
GEMINI_API_KEY=
PEXELS_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Optional variables (Settings -> Variables, or edit workflow env):
# VISIBILITY=private
# Optional failure alerts (Secrets; set either or both, or neither):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Optional duration guard bounds (seconds):
# MIN_AUDIO_SEC=10
# MAX_AUDIO_SEC=180
# Optional TTS prosody (dramatic horror delivery; edge-tts relative values):
# TTS_RATE=-10%
# TTS_PITCH=-8Hz
# TTS_VOLUME=+0%
# Optional Gemini model override (tried in order, first win):
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# Optional: Pollinations account key (sk_...) for watermark-free AI stills.
# Get it at enter.pollinations.ai/keys, store as a Secret (never commit it).
# POLLINATIONS_API_KEY=sk_...
# Optional: Cloudflare Workers AI for free watermark-free FLUX stills
# (10k neurons/day, no card). Sign up at dash.cloudflare.com, then:
# Account ID (dashboard sidebar) + API token with Workers AI permission.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
