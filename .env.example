# Copy these into GitHub repo: Settings -> Secrets and variables -> Actions -> New repository secret
GEMINI_API_KEY=
# Optional extra Gemini keys (or comma-separate keys in GEMINI_API_KEY):
# the pipeline fails over to the next key when one is rate-limited (429).
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
PEXELS_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Optional variables (Settings -> Variables, or edit workflow env):
# VISIBILITY=private
# Optional failure alerts (Secrets; set either or both, or neither):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Optional duration guard bounds (seconds). Narration targets ~120s (2-min
# Short); the guard only rejects broken TTS output, so leave wide.
# MIN_AUDIO_SEC=10
# MAX_AUDIO_SEC=180
# Optional TTS prosody (dramatic horror delivery; edge-tts relative values):
# TTS_RATE=-5%
# TTS_PITCH=-10Hz
# TTS_VOLUME=+0%
# Optional background music volume (linear scale, default 0.08; 0.20 was old loud level):
# BGM_VOLUME=0.08
# TTS engine chain (default gemini -> edge; "edge" = free edge-tts only
# with word-level captions; remote engine uses beat-level captions):
# TTS_ENGINE=edge
# Optional: Gemini TTS narrator voice (default Charon; a comma-separated
# pool alternates voices per run instead). 30 prebuilt voices (AI Studio voice library),
# e.g. Charon/Fenrir male, Kore/Aoede female:
# GEMINI_TTS_VOICES=Charon
# Optional: Gemini TTS delivery style (plain-language direction). Empty/unset
# defaults to adaptive narration-dependent delivery: natural articulate documentary
# storyteller voice that dynamically tunes per beat (hook intrigue -> countdown
# momentum -> #1 reveal awe -> warm outro) and content mood (danger, scale, speed, mystery).
# Setting a non-blank style acts as an explicit base style override:
# GEMINI_TTS_STYLE=Read in a natural, articulate documentary voice with steady pacing.
# OpenRouter :free text failover for Gemini outages (warn-only fallback,
# max 2 models x 1 try, never raises; code default wins so no workflow
# change needed):
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free
# OpenRouter model for Pillow visual code generation (fallback when Gemini fails).
# Qwen3.8-27B is the free-tier coder model; override to any OpenRouter model slug:
# OPENROUTER_VISUAL_MODEL=qwen/qwen3.8-27b:free
# Optional model override (tried in order, first win):
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# Optional Gemini failover pacing (fail fast during outages: short timeout,
# few tries; timeouts jump to the next key immediately, fast 5xx may retry,
# 429 backs off with jitter on the same key). GEMINI_TIMEOUT is the text
# path (script/topic); TTS voice calls run longer (healthy calls reach 20s+,
# keep 60-120):
# GEMINI_TIMEOUT=40
# GEMINI_TTS_TIMEOUT=90
# GEMINI_TRIES=2
# GEMINI_BACKOFF=5
# Hybrid topics: Gemini proposes a fresh explainer topic each run (validated,
# pool backstop on reject/fail). Kill switch if quota hurts:
# AI_TOPICS=off
# Optional: cuts per story beat (ranking niche STILLS_PER_BEAT=2,
# explainer niche EXPLAINER_STILLS_PER_BEAT=2; 1 = one visual per beat).
# STILLS_PER_BEAT=2
# EXPLAINER_STILLS_PER_BEAT=2
# Optional: TikTok dual-post via Buffer (free plan: 3 channels, 10 queued
# posts/channel, 1 API key). YouTube upload stays as-is; only TikTok goes
# through Buffer (Buffer's audited TikTok app posts publicly, no TikTok
# audit of your own needed). Buffer has no upload endpoint, so the mp4 must
# be hosted at a public URL first — Cloudinary unsigned preset (free tier,
# hardcoded defaults in core.py: cloud "epuxrxa5", preset "buffer_shorts").
# 1. buffer.com -> connect TikTok channel only -> publish.buffer.com/settings/api -> key
# 2. Cloudinary defaults already work; override only if you use your own account:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# BUFFER_API_KEY=
# BUFFER_TIKTOK_CHANNEL_ID=  # optional: auto-picks the TikTok channel when empty
# Optional contact for the advisory Wikipedia existence check User-Agent
# (MediaWiki policy asks for a reachable contact; built-in default wins,
# so no workflow change is required):
# WIKI_CONTACT=mailto:you@example.com
