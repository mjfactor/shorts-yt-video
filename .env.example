# Copy these into GitHub repo: Settings -> Secrets and variables -> Actions -> New repository secret
GEMINI_API_KEY=
# Optional extra Gemini keys (or comma-separate keys in GEMINI_API_KEY):
# the pipeline fails over to the next key when one is rate-limited (429).
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
PEXELS_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Optional variables (Settings -> Variables, or edit workflow env):
# VISIBILITY=private
# Optional failure alerts (Secrets; set either or both, or neither):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Optional duration guard bounds (seconds). Narration targets ~120s (2-min
# Short); the guard only rejects broken TTS output, so leave wide.
# MIN_AUDIO_SEC=10
# MAX_AUDIO_SEC=180
# Optional TTS prosody (dramatic horror delivery; edge-tts relative values):
# TTS_RATE=-5%
# TTS_PITCH=-10Hz
# TTS_VOLUME=+0%
# TTS engine chain (default gemini -> edge; "edge" = free edge-tts only
# with word-level captions; remote engine uses beat-level captions):
# TTS_ENGINE=edge
# Optional: Gemini TTS voice pool, comma-separated — ONE voice per run,
# alternating between runs by history entry count (default Charon,Kore =
# male one run, female the next; a single voice disables alternation).
# 30 prebuilt voices (AI Studio voice library), e.g. Charon/Fenrir male,
# Kore/Aoede female:
# GEMINI_TTS_VOICES=Charon,Kore
# Optional: Gemini TTS delivery style (plain-language direction). Empty/unset
# keeps per-run tone alternation: even history count -> energetic countdown
# narrator, odd -> chill deadpan lazy narrator (a loud punchy hook dropping
# into a deadpan body is the joke). Beat 0 (hook) always gets an extra
# super-energetic punch prefix on either tone. Setting a non-blank style
# wins for the body and skips tone alternation that run:
# GEMINI_TTS_STYLE=Read in a single energetic countdown-narrator voice.
# Reserved for future OpenRouter use (no engine reads it yet; keep the
# secret wired so a future engine needs no workflow change):
# OPENROUTER_API_KEY=
# Optional model override (tried in order, first win):
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# Hybrid topics: Gemini proposes a fresh countdown topic each run (validated,
# pool backstop on reject/fail). Kill switch if quota hurts:
# AI_TOPICS=off
# Optional: cuts per story beat (2 = ~14-16 clips per ~2-min video, mid-beat
# cuts like real Shorts pacing; 1 = one clip per beat slideshow).
# STILLS_PER_BEAT=2
# Optional: Cloudflare Workers AI fallback when Pexels has no stock
# (10k neurons/day, no card). Sign up at dash.cloudflare.com, then:
# Account ID (dashboard sidebar) + API token with Workers AI permission.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# Optional: Cloudflare image model + steps. Default is SDXL-Lightning (fast,
# cheapest neurons) but it adheres weakly to exact moments/actions — if stills
# look generic, try FLUX-schnell (better adherence, more neurons per image)
# and/or raise steps (8→12-20 helps Lightning moderately).
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CF_NUM_STEPS=8
# Optional: TikTok dual-post via Buffer (free plan: 3 channels, 10 queued
# posts/channel, 1 API key). YouTube upload stays as-is; only TikTok goes
# through Buffer (Buffer's audited TikTok app posts publicly, no TikTok
# audit of your own needed). Buffer has no upload endpoint, so the mp4 must
# be hosted at a public URL first — Cloudinary unsigned preset (free tier,
# hardcoded defaults in core.py: cloud "epuxrxa5", preset "buffer_shorts").
# 1. buffer.com -> connect TikTok channel only -> publish.buffer.com/settings/api -> key
# 2. Cloudinary defaults already work; override only if you use your own account:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# BUFFER_API_KEY=
# BUFFER_TIKTOK_CHANNEL_ID=  # optional: auto-picks the TikTok channel when empty
