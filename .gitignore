# Generated output + caches. Never commit these.
out/
assets/*
__pycache__/
*.pyc
.env
.venv/
# Phase 2 caches: downloaded stock + background videos are never committed;
# placeholder .gitkeep files are re-included so empty dirs stay tracked.
# Brand assets ARE committed: fonts (*.ttf/*.otf) + avatar.png.
assets/pexels_cache/*
assets/backgrounds/*
assets/fonts/*
assets/background-musics/*
!assets/fonts/
!assets/avatar.png
!assets/pexels_cache/
!assets/backgrounds/
# BGM pool (bgm*.mp3) IS committed: the daily CI run needs real music.
# Uploaded background clips (bg1.mp4 ...) ARE committed too: they are the
# primary background source in single-clip mode. The directory must be
# un-ignored before the file pattern re-includes it (assets/* above
# excludes the whole directory).
!assets/background-musics/
!assets/background-musics/bgm*.mp3
# BGM provenance manifest (sha256 + license/claim state) IS committed too:
# a Content ID claim has to map back to a file, in CI as well as locally.
!assets/background-musics/bgm_manifest.json
!assets/backgrounds/*.mp4
!assets/backgrounds/*.mov
!assets/backgrounds/*.webm
!assets/backgrounds/*.mkv
!assets/pexels_cache/.gitkeep
!assets/backgrounds/.gitkeep
!assets/fonts/.gitkeep
!assets/fonts/*.ttf
!assets/fonts/*.otf
